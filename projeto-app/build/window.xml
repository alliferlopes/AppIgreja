ble="false" password="false" selected="false" bounds="[0,1364][1344,2492]" drawing-order="2" hint=""><node index="0" text="Missão" resource-id="" class="android.widget.TextView" package="br.com.luzespe.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,1439][1284,1544]" drawing-order="1" hint="" /><node index="1" text="Compartilhando o amor de Deus através da fé cristã." resource-id="" class="android.widget.TextView" package="br.com.luzespe.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,1544][1284,1683]" drawing-order="2" hint="" /><node index="2" text="Nossa missão é levar a mensagem de amor, esperança e salvação através do evangelho de Jesus Cristo, alcançando pessoas de todas as idades e fortalecendo famílias por meio da fé cristã." resource-id="" class="android.widget.TextView" package="br.com.luzespe.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,1683][1284,1972]" drawing-order="3" hint="" /><node index="3" text="Buscamos ser uma igreja acolhedora, comprometida com os ensinamentos bíblicos e com o desenvolvimento espiritual, emocional e social da comunidade." resource-id="" class="android.widget.TextView" package="br.com.luzespe.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,1972][1284,2199]" drawing-order="4" hint="" /><node index="4" text="Também temos como propósito incentivar a solidariedade, o cuidado com o próximo e a prática dos valores cristãos no dia a dia." resource-id="" class="android.widget.TextView" package="br.com.luzespe.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,2199][1284,2426]" drawing-order="5" hint="" /></node><node index="2" text="" resource-id="" class="android.widget.LinearLayout" package="br.com.luzespe.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2492][1344,2920]" drawing-order="3" hint=""><node index="0" text="Nossa Comunidade" resource-id="" class="android.widget.TextView" package="br.com.luzespe.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,2567][1284,2717]" drawing-order="1" hint="" /><node index="1" text="Nossa comunidade é formada por pessoas e famílias que compartilham da fé cristã e do desejo de crescer espiritualmente em união e amor ao próximo." resource-id="" class="android.widget.TextView" package="br.com.luzespe.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,2717][1284,2920]" drawing-order="2" hint="" /></node></node></node></node></node></node></node></hierarchy>